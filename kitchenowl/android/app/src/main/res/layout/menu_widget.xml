<?xml version="1.0" encoding="utf-8"?>
<!-- Today's menu, filled by MenuWidgetProvider.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_widget_background"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/menu_widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/menu_widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/menu_widget_breakfast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/menu_widget_breakfast_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/menu_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/menu_widget_breakfast_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/menu_widget_text"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/menu_widget_lunch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/menu_widget_lunch_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/menu_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/menu_widget_lunch_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/menu_widget_text"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/menu_widget_dinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/menu_widget_dinner_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/menu_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/menu_widget_dinner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/menu_widget_text"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/menu_widget_any"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/menu_widget_any_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/menu_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/menu_widget_any_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/menu_widget_text"
            android:textSize="14sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/menu_widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/menu_widget_open_app"
        android:textColor="@color/menu_widget_text_secondary"
        android:textSize="14sp" />
    <!-- Spacer pushing "updated" to the bottom. Not a plain View: widgets
         may only inflate the classes RemoteViews allows. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/menu_widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/menu_widget_text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
