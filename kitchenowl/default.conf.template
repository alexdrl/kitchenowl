server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/web/kitchenowl;
    index index.html

    server_name _;

    location / {
        client_max_body_size 32M;
        try_files $uri $uri/ /index.html;
    }
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|manifest\.json|version\.json)$ {
        add_header Cache-Control "no-cache";
    }
    # nginx's mime.types has no .mjs: without this the Flutter wasm loader
    # (main.dart.*.mjs) is served as application/octet-stream and browsers
    # refuse it as a module script
    location ~* \.mjs$ {
        types { application/javascript mjs; }
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~* ^/assets/|\.(js|wasm|symbols)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location /api/ {
        include uwsgi_params;
        uwsgi_pass ${BACK_URL};
        client_max_body_size 32M;
    }
    location /mcp {
        include uwsgi_params;
        proxy_buffering off;
        uwsgi_buffering off;
        uwsgi_pass ${BACK_URL};
    }
    location /socket.io/ {
        include uwsgi_params;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        uwsgi_buffering off;
        uwsgi_pass ${BACK_URL};
    }
}
server {
    listen 9100;
    location /metrics/ {
        include uwsgi_params;
        uwsgi_pass ${BACK_URL};
    }
}
